{
  "schemaVersion": 1,
  "kind": "sdkwork.api.assembly.manifest",
  "assembly": {
    "name": "sdkwork-api-generations-assembly",
    "application": "sdkwork-generations",
    "description": "Generations API assembly composing app-api and backend-api surfaces."
  },
  "routeCrates": [
    "sdkwork-routes-generations-app-api",
    "sdkwork-routes-generations-backend-api"
  ],
  "surfaces": {
    "appApi": {
      "crate": "sdkwork-routes-generations-app-api",
      "prefix": "/app/v3/api/generations"
    },
    "backendApi": {
      "crate": "sdkwork-routes-generations-backend-api",
      "prefix": "/backend/v3/api/generations"
    }
  }
}
